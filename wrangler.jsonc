{
  "name": "escort",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "PROFILE_IMAGES",
      "bucket_name": "admin"
    }
  ],
  "vars": {
    "R2_PUBLIC_BASE_URL": "https://pub-db389dd5f7f34f0dba7af1f11313f7e4.r2.dev"
  }
}
