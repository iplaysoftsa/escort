rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (request.auth.uid == 'xqizc70R2dPYeC75dSAfx2LqTQU2'
          || request.auth.token.get('admin', false) == true);
    }

    function creatorInvitePath(inviteId) {
      return /databases/$(database)/documents/creatorInvites/$(inviteId);
    }

    function creatorAccountPath(uid) {
      return /databases/$(database)/documents/creatorAccounts/$(uid);
    }

    function isInviteAttempt() {
      return request.auth == null
        && resource.data.get('status', '') == 'pending'
        && resource.data.get('expiresAt', timestamp.date(1970, 1, 1)) > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts'])
        && request.resource.data.get('attempts', 0) == resource.data.get('attempts', 0) + 1
        && request.resource.data.get('attempts', 0) <= 3;
    }

    function hasMatchingCreatorAfter(uid, inviteId) {
      let accountAfter = getAfter(creatorAccountPath(uid));
      let inviteAfter = getAfter(creatorInvitePath(inviteId));
      return existsAfter(creatorAccountPath(uid))
        && existsAfter(creatorInvitePath(inviteId))
        && accountAfter.data.get('inviteId', '') == inviteId
        && accountAfter.data.get('creatorId', '') == inviteAfter.data.get('creatorId', '')
        && accountAfter.data.get('email', '') == inviteAfter.data.get('email', '')
        && accountAfter.data.get('profileId', '') == inviteAfter.data.get('profileId', '')
        && accountAfter.data.get('verificationStatus', '') == inviteAfter.data.get('verificationStatus', '');
    }

    function isInviteClaim(inviteId) {
      return request.auth != null
        && resource.data.get('status', '') == 'pending'
        && resource.data.get('expiresAt', timestamp.date(1970, 1, 1)) > request.time
        && resource.data.get('attempts', 0) >= 1
        && resource.data.get('attempts', 0) <= 3
        && request.auth.token.get('email', '') == resource.data.get('email', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'claimedUid', 'claimedAt', 'passwordStatus', 'updatedAt'
        ])
        && request.resource.data.get('status', '') == 'used'
        && request.resource.data.get('claimedUid', '') == request.auth.uid
        && request.resource.data.get('claimedAt', null) == request.time
        && request.resource.data.get('passwordStatus', '') == 'created'
        && request.resource.data.get('updatedAt', null) == request.time
        && hasMatchingCreatorAfter(request.auth.uid, inviteId);
    }

    function isValidCreatorAccountCreate(uid) {
      let inviteId = request.resource.data.get('inviteId', '');
      let inviteAfter = getAfter(creatorInvitePath(inviteId));
      return request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'creatorId', 'email', 'profileId', 'displayName', 'verificationStatus',
          'passwordStatus', 'active', 'inviteId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.get('creatorId', '') is string
        && request.resource.data.get('creatorId', '').matches('^RR-ID-[0-9]{5}$')
        && request.resource.data.get('email', '') == request.auth.token.get('email', '')
        && request.resource.data.get('profileId', '') is string
        && request.resource.data.get('profileId', '').matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.get('displayName', '') is string
        && request.resource.data.get('verificationStatus', '') in ['pending', 'verified']
        && request.resource.data.get('passwordStatus', '') == 'created'
        && request.resource.data.get('active', false) == true
        && request.resource.data.get('inviteId', '') is string
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('updatedAt', null) == request.time
        && existsAfter(creatorInvitePath(inviteId))
        && inviteAfter.data.get('status', '') == 'used'
        && inviteAfter.data.get('claimedUid', '') == uid
        && inviteAfter.data.get('creatorId', '') == request.resource.data.get('creatorId', '')
        && inviteAfter.data.get('email', '') == request.resource.data.get('email', '')
        && inviteAfter.data.get('verificationStatus', '') == request.resource.data.get('verificationStatus', '')
        && inviteAfter.data.get('profileId', '') == request.resource.data.get('profileId', '');
    }

    function profileViewEventPath(profileId) {
      return /databases/$(database)/documents/profileViewEvents/$(profileId + "_" + request.auth.uid);
    }

    function videoViewEventPath(profileId, videoId) {
      return /databases/$(database)/documents/videoViewEvents/$(profileId + "_" + videoId + "_" + request.auth.uid);
    }

    function profileHasVideo(profileData, videoId) {
      return profileData.get('videoIds', []).hasAny([videoId])
        || (videoId == 'legacy' && profileData.get('videoUrl', '') is string
          && profileData.get('videoUrl', '') != '');
    }

    function isProfileViewIncrement(profileId) {
      let eventPath = profileViewEventPath(profileId);
      let existingViews = resource.data.get('views', 0);
      let eventAfter = getAfter(eventPath);
      return request.auth != null
        && resource.data.get('status', 'check') != 'hidden'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.get('views', 0) == existingViews + 1
        && existsAfter(eventPath)
        && eventAfter.data.profileId == profileId
        && eventAfter.data.viewerUid == request.auth.uid
        && eventAfter.data.viewedAt == request.time
        && (!exists(eventPath)
          || get(eventPath).data.viewedAt < request.time - duration.value(1, 'd'));
    }

    function isVideoViewIncrement(profileId, videoId) {
      let eventPath = videoViewEventPath(profileId, videoId);
      let previousViews = resource.data.get('videoViews', {});
      let updatedViews = request.resource.data.get('videoViews', {});
      let eventAfter = getAfter(eventPath);
      return request.auth != null
        && videoId is string
        && videoId.matches('^[A-Za-z0-9_-]{1,128}$')
        && resource.data.get('status', 'check') != 'hidden'
        && profileHasVideo(resource.data, videoId)
        && request.resource.data.get('videoViewId', '') == videoId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['videoViews', 'videoViewId'])
        && updatedViews.diff(previousViews).affectedKeys().hasOnly([videoId])
        && updatedViews.get(videoId, 0) == previousViews.get(videoId, 0) + 1
        && existsAfter(eventPath)
        && eventAfter.data.profileId == profileId
        && eventAfter.data.videoId == videoId
        && eventAfter.data.viewerUid == request.auth.uid
        && eventAfter.data.viewedAt == request.time
        && (!exists(eventPath)
          || get(eventPath).data.viewedAt < request.time - duration.value(1, 'd'));
    }

    function isCreatorProfilePublication(profileId) {
      return request.auth != null
        && existsAfter(creatorAccountPath(request.auth.uid))
        && isAuthenticatedCreatorProfilePublication(profileId, request.auth.uid);
    }

    function isAuthenticatedCreatorProfilePublication(profileId, uid) {
      let accountAfter = getAfter(creatorAccountPath(uid));
      let inviteId = accountAfter.data.get('inviteId', '');
      let inviteAfter = getAfter(creatorInvitePath(inviteId));
      return profileId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published', 'updatedAt'])
        && request.resource.data.get('published', false) == true
        && request.resource.data.get('updatedAt', null) == request.time
        && resource.data.get('published', false) != true
        && existsAfter(creatorAccountPath(uid))
        && accountAfter.data.get('profileId', '') == profileId
        && accountAfter.data.get('active', false) == true
        && accountAfter.data.get('passwordStatus', '') == 'created'
        && existsAfter(creatorInvitePath(inviteId))
        && inviteAfter.data.get('status', '') == 'used'
        && inviteAfter.data.get('claimedUid', '') == uid
        && inviteAfter.data.get('passwordStatus', '') == 'created'
        && inviteAfter.data.get('profileId', '') == profileId;
    }

    function isLinkedCreatorProfile(profileId) {
      return request.auth != null
        && hasLinkedCreatorProfile(profileId, request.auth.uid);
    }

    function hasLinkedCreatorProfile(profileId, uid) {
      let accountPath = creatorAccountPath(uid);
      return exists(accountPath)
        && get(accountPath).data.get('profileId', '') == profileId
        && get(accountPath).data.get('active', false) == true
        && get(accountPath).data.get('passwordStatus', '') == 'created';
    }

    function sameVideoDetails(before, after) {
      return before is map
        && after is map
        && after.diff(before).affectedKeys().hasOnly(['title', 'description'])
        && after.get('title', '') is string
        && after.get('title', '').size() <= 100
        && after.get('description', '') is string
        && after.get('description', '').size() <= 300;
    }

    function videoDetailsAtMatch(before, after, index) {
      return before.size() <= index
        || sameVideoDetails(before[index], after[index]);
    }

    function isCreatorVideoDetailsUpdate(before, after) {
      return before is list
        && after is list
        && before.size() == after.size()
        && before.size() <= 20
        && videoDetailsAtMatch(before, after, 0)
        && videoDetailsAtMatch(before, after, 1)
        && videoDetailsAtMatch(before, after, 2)
        && videoDetailsAtMatch(before, after, 3)
        && videoDetailsAtMatch(before, after, 4)
        && videoDetailsAtMatch(before, after, 5)
        && videoDetailsAtMatch(before, after, 6)
        && videoDetailsAtMatch(before, after, 7)
        && videoDetailsAtMatch(before, after, 8)
        && videoDetailsAtMatch(before, after, 9)
        && videoDetailsAtMatch(before, after, 10)
        && videoDetailsAtMatch(before, after, 11)
        && videoDetailsAtMatch(before, after, 12)
        && videoDetailsAtMatch(before, after, 13)
        && videoDetailsAtMatch(before, after, 14)
        && videoDetailsAtMatch(before, after, 15)
        && videoDetailsAtMatch(before, after, 16)
        && videoDetailsAtMatch(before, after, 17)
        && videoDetailsAtMatch(before, after, 18)
        && videoDetailsAtMatch(before, after, 19);
    }

    function isCreatorProfileUpdate(profileId) {
      let updated = request.resource.data;
      let changed = updated.diff(resource.data).affectedKeys();
      return isLinkedCreatorProfile(profileId)
        && changed.hasOnly([
          'name', 'area', 'rateAmount', 'status', 'age', 'height', 'dressSize',
          'hairColor', 'eyeColor', 'bio', 'languages', 'personality',
          'travelAreas', 'preferredVenues', 'extendedRates', 'services', 'videos', 'updatedAt'
        ])
        && (!changed.hasAny(['videos'])
          || isCreatorVideoDetailsUpdate(resource.data.get('videos', []), updated.get('videos', [])))
        && updated.get('name', '') is string
        && updated.get('name', '').size() > 0
        && updated.get('name', '').size() <= 60
        && updated.get('area', '') is string
        && updated.get('area', '').size() > 0
        && updated.get('area', '').size() <= 80
        && updated.get('rateAmount', 0) is int
        && updated.get('rateAmount', 0) >= 500
        && updated.get('rateAmount', 0) <= 1000000
        && (resource.data.get('status', '') == 'hidden'
          ? updated.get('status', '') == 'hidden'
          : updated.get('status', '') in ['available', 'check'])
        && updated.get('age', 0) is int
        && updated.get('age', 0) >= 18
        && updated.get('age', 0) <= 99
        && updated.get('height', '') is string
        && updated.get('height', '').size() <= 16
        && updated.get('dressSize', '') is string
        && updated.get('dressSize', '').size() <= 30
        && updated.get('hairColor', '') is string
        && updated.get('hairColor', '').size() <= 50
        && updated.get('eyeColor', '') is string
        && updated.get('eyeColor', '').size() <= 50
        && updated.get('bio', '') is string
        && updated.get('bio', '').size() <= 600
        && updated.get('languages', []) is list
        && updated.get('languages', []).size() <= 30
        && updated.get('personality', '') is string
        && updated.get('personality', '').size() <= 600
        && updated.get('travelAreas', []) is list
        && updated.get('travelAreas', []).size() <= 30
        && updated.get('preferredVenues', []) is list
        && updated.get('preferredVenues', []).size() <= 30
        && updated.get('extendedRates', []) is list
        && updated.get('extendedRates', []).size() <= 30
        && updated.get('services', []) is list
        && updated.get('services', []).size() <= 30
        && updated.get('updatedAt', null) == request.time;
    }

    function isValidCreatorPayoutSettings(uid) {
      let data = request.resource.data;
      let profileId = data.get('profileId', '');
      let method = data.get('method', '');
      return request.auth != null
        && request.auth.uid == uid
        && data.keys().hasOnly([
          'profileId', 'method', 'accountHolder', 'bankName', 'accountType',
          'accountNumber', 'branchCode', 'walletProvider', 'walletNumber', 'updatedAt'
        ])
        && profileId is string
        && isLinkedCreatorProfile(profileId)
        && method in ['bank-transfer', 'mobile-wallet']
        && data.get('accountHolder', '') is string
        && data.get('accountHolder', '').size() <= 80
        && data.get('bankName', '') is string
        && data.get('bankName', '').size() <= 80
        && data.get('accountType', '') is string
        && data.get('accountType', '') in ['', 'cheque', 'savings', 'transmission']
        && data.get('accountNumber', '') is string
        && data.get('accountNumber', '').size() <= 20
        && data.get('branchCode', '') is string
        && data.get('branchCode', '').size() <= 10
        && data.get('walletProvider', '') is string
        && data.get('walletProvider', '').size() <= 80
        && data.get('walletNumber', '') is string
        && data.get('walletNumber', '').size() <= 16
        && data.get('updatedAt', null) == request.time
        && (method == 'bank-transfer'
          ? data.get('accountHolder', '').size() >= 2
            && data.get('bankName', '').size() >= 2
            && data.get('accountType', '') in ['cheque', 'savings', 'transmission']
            && data.get('accountNumber', '').matches('^[0-9]{6,20}$')
            && (data.get('branchCode', '') == ''
              || data.get('branchCode', '').matches('^[0-9]{3,10}$'))
          : data.get('walletProvider', '').size() >= 2
            && data.get('walletNumber', '').matches('^(\\+27|0)[0-9]{9}$'));
    }

    function isValidProfileViewMarker(profileId) {
      let profilePath = /databases/$(database)/documents/companions/$(profileId);
      let profileBefore = get(profilePath).data;
      let profileAfter = getAfter(profilePath).data;
      return request.auth != null
        && profileId is string
        && profileId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.keys().hasOnly(['profileId', 'viewerUid', 'viewedAt'])
        && request.resource.data.get('profileId', '') == profileId
        && request.resource.data.get('viewerUid', '') == request.auth.uid
        && request.resource.data.get('viewedAt', null) == request.time
        && exists(profilePath)
        && profileBefore.get('status', 'check') != 'hidden'
        && existsAfter(profilePath)
        && profileAfter.get('views', 0) == profileBefore.get('views', 0) + 1
        && profileAfter.diff(profileBefore).affectedKeys().hasOnly(['views']);
    }

    function isValidVideoViewMarker(profileId, videoId) {
      let profilePath = /databases/$(database)/documents/companions/$(profileId);
      let profileBefore = get(profilePath).data;
      let profileAfter = getAfter(profilePath).data;
      let previousViews = profileBefore.get('videoViews', {});
      let updatedViews = profileAfter.get('videoViews', {});
      return request.auth != null
        && profileId is string
        && profileId.matches('^[A-Za-z0-9_-]{1,128}$')
        && videoId is string
        && videoId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.keys().hasOnly(['profileId', 'videoId', 'viewerUid', 'viewedAt'])
        && request.resource.data.get('profileId', '') == profileId
        && request.resource.data.get('videoId', '') == videoId
        && request.resource.data.get('viewerUid', '') == request.auth.uid
        && request.resource.data.get('viewedAt', null) == request.time
        && exists(profilePath)
        && profileBefore.get('status', 'check') != 'hidden'
        && profileHasVideo(profileBefore, videoId)
        && existsAfter(profilePath)
        && profileAfter.get('videoViewId', '') == videoId
        && updatedViews.get(videoId, 0) == previousViews.get(videoId, 0) + 1
        && updatedViews.diff(previousViews).affectedKeys().hasOnly([videoId])
        && profileAfter.diff(profileBefore).affectedKeys().hasOnly(['videoViews', 'videoViewId']);
    }

    match /companions/{docId} {
      allow get: if isAdmin()
        || resource.data.get('published', false) == true
        || isLinkedCreatorProfile(docId);
      allow list: if isAdmin() || resource.data.get('published', false) == true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || isProfileViewIncrement(docId)
        || isVideoViewIncrement(docId, request.resource.data.get('videoViewId', ''))
        || isCreatorProfilePublication(docId)
        || isCreatorProfileUpdate(docId);
    }

    match /bookings/{bookingId} {
      allow read, write: if isAdmin();
    }

    match /creatorBookingRequests/{bookingId} {
      allow get, list: if isAdmin()
        || (resource.data.get('profileId', '') is string
          && isLinkedCreatorProfile(resource.data.get('profileId', '')));
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isLinkedCreatorProfile(resource.data.get('profileId', ''))
          && resource.data.get('status', '') == 'pending'
          && request.resource.data.get('profileId', '') == resource.data.get('profileId', '')
          && request.resource.data.get('bookingId', '') == resource.data.get('bookingId', '')
          && request.resource.data.get('status', '') in ['accepted', 'declined']
          && request.resource.data.get('responseAt', null) == request.time
          && request.resource.data.get('updatedAt', null) == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'responseAt', 'updatedAt'
          ]));
    }

    match /creatorEarnings/{bookingId} {
      allow get, list: if isAdmin()
        || (resource.data.get('profileId', '') is string
          && isLinkedCreatorProfile(resource.data.get('profileId', '')));
      allow create, update, delete: if isAdmin();
    }

    match /creatorPayoutSettings/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if isAdmin() || isValidCreatorPayoutSettings(uid);
      allow delete: if isAdmin();
    }

    match /creatorPayouts/{payoutId} {
      allow get, list: if isAdmin()
        || (resource.data.get('profileId', '') is string
          && isLinkedCreatorProfile(resource.data.get('profileId', '')));
      allow create, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /profileViewEvents/{eventId} {
      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/profileViewEvents/$(eventId))
          || resource.data.viewerUid == request.auth.uid);
      allow list: if false;
      allow create: if request.resource.data.get('profileId', '') is string
        && eventId == request.resource.data.profileId + "_" + request.auth.uid
        && isValidProfileViewMarker(request.resource.data.profileId);
      allow update: if request.resource.data.get('profileId', '') is string
        && eventId == request.resource.data.profileId + "_" + request.auth.uid
        && resource.data.viewerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedAt'])
        && resource.data.viewedAt < request.time - duration.value(1, 'd')
        && isValidProfileViewMarker(request.resource.data.profileId);
      allow delete: if false;
    }

    match /videoViewEvents/{eventId} {
      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/videoViewEvents/$(eventId))
          || resource.data.viewerUid == request.auth.uid);
      allow list: if false;
      allow create: if request.resource.data.get('profileId', '') is string
        && request.resource.data.get('videoId', '') is string
        && eventId == request.resource.data.profileId + "_" + request.resource.data.videoId + "_" + request.auth.uid
        && isValidVideoViewMarker(request.resource.data.profileId, request.resource.data.videoId);
      allow update: if request.resource.data.get('profileId', '') is string
        && request.resource.data.get('videoId', '') is string
        && eventId == request.resource.data.profileId + "_" + request.resource.data.videoId + "_" + request.auth.uid
        && resource.data.viewerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedAt'])
        && resource.data.viewedAt < request.time - duration.value(1, 'd')
        && isValidVideoViewMarker(request.resource.data.profileId, request.resource.data.videoId);
      allow delete: if false;
    }

    match /creatorAccounts/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if isValidCreatorAccountCreate(uid);
      allow update, delete: if isAdmin();
    }

    match /creatorInvites/{inviteId} {
      allow get: if isAdmin()
        || (resource.data.get('status', '') == 'pending'
          && resource.data.get('expiresAt', timestamp.date(1970, 1, 1)) > request.time
          && (resource.data.get('attempts', 0) < 3
            || (request.auth != null
              && request.auth.token.get('email', '') == resource.data.get('email', ''))));
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isInviteAttempt() || isInviteClaim(inviteId);
    }

    match /profileDrafts/{draftId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
