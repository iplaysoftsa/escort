{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "firestore.rules",
      "package.json",
      "package-lock.json",
      "config.js"
    ],
    "rewrites": [
      {
        "source": "/setup-password.html",
        "destination": "/public/setup-password.html"
      },
      {
        "source": "/",
        "destination": "/public/index.html"
      }
    ]
  }
}
